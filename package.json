{
  "name": "Reciptor",
  "version": "1.0.0",
  "description": "Fullstack monorepo with React, Next.js, Prisma, PostgreSQL and Docker",
  "main": "index.js",
  "scripts": {
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "pnpm --filter frontend build && pnpm --filter backend build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:migrate": "pnpm --filter backend exec prisma migrate dev",
    "db:studio": "pnpm --filter backend exec prisma studio",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.34.5",
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
  }
}
